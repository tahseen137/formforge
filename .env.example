# Supabase Configuration
# Get these from https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend Email Configuration
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM=FormForge <notifications@yourdomain.com>

# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signing secret
# Get this from https://dashboard.stripe.com/webhooks after creating your endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Client-side Stripe key (same as STRIPE_PUBLISHABLE_KEY)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe Price IDs
# Create these in Stripe Dashboard > Products
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_BUSINESS_PRICE_ID=price_xxx
