# ===========================================
# Supabase Configuration
# Get these from https://supabase.com/dashboard
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key for backend operations (keep this secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Email (Resend)
# Get API key from https://resend.com/api-keys
# ===========================================
RESEND_API_KEY=re_xxx

# Email sender (default uses Resend test domain)
# For production, use your verified domain: FormForge <notifications@yourdomain.com>
EMAIL_FROM=FormForge <onboarding@resend.dev>

# ===========================================
# Stripe Configuration (optional for billing)
# Get these from https://dashboard.stripe.com/apikeys
# ===========================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signing secret
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs for subscription plans
STRIPE_PRO_PRICE_ID=price_xxx
STRIPE_BUSINESS_PRICE_ID=price_xxx
